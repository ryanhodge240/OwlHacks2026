{
    "name": "owlhacks2026",
    "version": "0.1.0",
    "private": true,
    "dependencies": {
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^13.5.0",
        "bootstrap": "^5.3.8",
        "bcryptjs": "^3.0.2",
        "express": "^5.1.0",
        "express-rate-limit": "^8.2.1",
        "pg": "^8.16.3",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-icons": "^5.6.0",
        "react-scripts": "5.0.1",
        "web-vitals": "^2.1.4"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^24.5.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.1.9",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.6.2",
        "typescript": "^4.9.5"
    },
    "scripts": {
        "start": "react-scripts start",
        "build": "react-scripts build",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint src server --ext .js,.ts,.tsx",
        "check": "npm run format:check && npm run lint && npm test -- --watchAll=false && npm run build",
        "serve": "node server/index.js",
        "prod": "npm run build && npm run serve",
        "test": "react-scripts test",
        "eject": "react-scripts eject"
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest",
            "prettier"
        ],
        "overrides": [
            {
                "files": [
                    "server/**/*.js"
                ],
                "env": {
                    "node": true,
                    "es2022": true
                }
            }
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
